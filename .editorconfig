root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,xaml,ps1,iss}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
end_of_line = lf

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
