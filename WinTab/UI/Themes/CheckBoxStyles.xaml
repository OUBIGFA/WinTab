<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WinTab.UI.Views.Controls">

    <Style x:Key="SwitchFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2,3" CornerRadius="14" BorderThickness="2"
                            BorderBrush="{DynamicResource FocusRingBrush}" Opacity="0.65" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shadcn-style solid thumb and track, with a larger invisible pointer target. -->
    <Style x:Key="CustomCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SwitchFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Target" Background="Transparent" MinWidth="48" MinHeight="32">
                        <Grid Width="36" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="SwitchTrack" CornerRadius="10" Background="{DynamicResource SwitchOffBrush}" />
                            <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Margin="2,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource SwitchThumbBrush}">
                                <Ellipse.RenderTransform><TranslateTransform X="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Target" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundBrush}" />
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource CheckBoxCheckedGlyphBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SwitchThumb"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     To="16" Duration="0:0:0.15" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SwitchThumb"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     To="0" Duration="0:0:0.15" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shortcut enablement uses the same themed square checkbox in both languages. -->
    <Style x:Key="LabeledCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" Background="{DynamicResource SurfaceBrush}">
                            <controls:LineIcon x:Name="Check" Data="{StaticResource CheckIcon}" Width="14" Height="14"
                                               Foreground="{DynamicResource CheckBoxCheckedGlyphBrush}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Content="{TemplateBinding Content}" Margin="8,0,0,0"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckBoxCheckedBackgroundBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBoxCheckedBorderBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
