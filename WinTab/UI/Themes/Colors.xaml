<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Grayscale only. ThemeManager replaces these at startup for dark mode. -->
    <Color x:Key="PrimaryColor">#2A2A2A</Color>
    <Color x:Key="PrimaryLightColor">#5E5E5E</Color>
    <Color x:Key="TextPrimaryColor">#252525</Color>
    <Color x:Key="TextSecondaryColor">#606060</Color>
    <Color x:Key="TextTertiaryColor">#7A7A7A</Color>
    <Color x:Key="TextAccentColor">#181818</Color>
    <Color x:Key="BorderColor">#CCCCCC</Color>
    <Color x:Key="DividerColor">#DEDEDE</Color>
    <Color x:Key="ControlBackgroundColor">#EFEFEF</Color>
    <Color x:Key="ControlHoverColor">#E4E4E4</Color>
    <Color x:Key="DropdownBackgroundColor">#FAFAFA</Color>
    <Color x:Key="ShadowColor">#5A5A5A</Color>
    <Color x:Key="CheckBoxCheckedBackgroundColor">#2A2A2A</Color>
    <Color x:Key="CheckBoxCheckedBorderColor">#2A2A2A</Color>
    <Color x:Key="CheckBoxCheckedGlyphColor">#EEEEEE</Color>
    <Color x:Key="StatusPillBackgroundColor">#E8E8E8</Color>
    <Color x:Key="StatusPillBorderColor">#CCCCCC</Color>
    <Color x:Key="FocusRingColor">#444444</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextAccentBrush" Color="{DynamicResource TextAccentColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource DividerColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{DynamicResource ControlHoverColor}" />
    <SolidColorBrush x:Key="DropdownBackgroundBrush" Color="{DynamicResource DropdownBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckedBackgroundBrush" Color="{DynamicResource CheckBoxCheckedBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckedBorderBrush" Color="{DynamicResource CheckBoxCheckedBorderColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckedGlyphBrush" Color="{DynamicResource CheckBoxCheckedGlyphColor}" />
    <SolidColorBrush x:Key="StatusPillBackgroundBrush" Color="{DynamicResource StatusPillBackgroundColor}" />
    <SolidColorBrush x:Key="StatusPillBorderBrush" Color="{DynamicResource StatusPillBorderColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource FocusRingColor}" />

    <!-- Solid surface brushes. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="WindowTitleBarBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#C7C7C7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#E9E9E9" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F6F6F6" />

</ResourceDictionary>
