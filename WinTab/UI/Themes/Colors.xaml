<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WinOne neutral roles; ThemeManager applies the matching dark palette at startup. -->
    <Color x:Key="PrimaryColor">#171717</Color>
    <Color x:Key="PrimaryLightColor">#404040</Color>
    <Color x:Key="TextPrimaryColor">#0A0A0A</Color>
    <Color x:Key="TextSecondaryColor">#707070</Color>
    <Color x:Key="TextTertiaryColor">#737373</Color>
    <Color x:Key="TextAccentColor">#171717</Color>
    <Color x:Key="BorderColor">#E5E5E5</Color>
    <Color x:Key="ControlBorderColor">#888888</Color>
    <Color x:Key="DividerColor">#E5E5E5</Color>
    <Color x:Key="ControlBackgroundColor">#F5F5F5</Color>
    <Color x:Key="ControlHoverColor">#EAEAEA</Color>
    <Color x:Key="DropdownBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ShadowColor">#5A5A5A</Color>
    <Color x:Key="CheckBoxCheckedBackgroundColor">#171717</Color>
    <Color x:Key="CheckBoxCheckedBorderColor">#171717</Color>
    <Color x:Key="CheckBoxCheckedGlyphColor">#FAFAFA</Color>
    <Color x:Key="FocusRingColor">#737373</Color>

    <Color x:Key="SwitchOffColor">#888888</Color>

    <Color x:Key="SwitchThumbColor">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextAccentBrush" Color="{DynamicResource TextAccentColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{DynamicResource ControlBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource DividerColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{DynamicResource ControlHoverColor}" />
    <SolidColorBrush x:Key="DropdownBackgroundBrush" Color="{DynamicResource DropdownBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckedBackgroundBrush" Color="{DynamicResource CheckBoxCheckedBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckedBorderBrush" Color="{DynamicResource CheckBoxCheckedBorderColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckedGlyphBrush" Color="{DynamicResource CheckBoxCheckedGlyphColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource FocusRingColor}" />

    <!-- Solid surface brushes. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WindowTitleBarBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SwitchOffBrush" Color="{DynamicResource SwitchOffColor}" />
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="{DynamicResource SwitchThumbColor}" />
</ResourceDictionary>
