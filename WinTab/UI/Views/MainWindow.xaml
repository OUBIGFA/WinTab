<Window x:Class="WinTab.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTab"
        Width="960"
        Height="760"
        MinWidth="720"
        MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource DefaultFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- The system owns the frame: shadow, Windows 11 rounded corners, resize edges and caption
         drag/double-click all come from DWM, while the caption strip itself is drawn below. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="SettingsGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="18,12" />
        </Style>

        <Style x:Key="LastSettingRowStyle" TargetType="Border" BasedOn="{StaticResource SettingRowStyle}">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="FootnoteStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingDescriptionStyle}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="4,8,4,0" />
        </Style>

        <Style x:Key="SettingToggleStyle" TargetType="CheckBox" BasedOn="{StaticResource CustomCheckBoxStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="24,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <!-- A maximized window is placed so its (invisible) frame sits off-screen; without this
                         inset the outer 8 DIPs of the client area would be clipped on every edge. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="ThemeToggleButton" Style="{StaticResource IconButtonStyle}" Focusable="False">
                <TextBlock x:Name="ThemeToggleGlyph" Style="{StaticResource GlyphIconStyle}" Text="&#xE708;" />
            </Button>
            <Button x:Name="LanguageToggleButton" Style="{StaticResource IconButtonStyle}" Margin="2,0,8,0" Focusable="False">
                <TextBlock Style="{StaticResource GlyphIconStyle}" Text="&#xF2B7;" />
            </Button>
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Focusable="False">
                <TextBlock Style="{StaticResource CaptionGlyphStyle}" Text="&#xE921;" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}" Margin="2,0,0,0" Focusable="False">
                <TextBlock Style="{StaticResource CaptionGlyphStyle}" Text="&#xE8BB;" />
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False">
            <StackPanel MaxWidth="800" Margin="40,10,40,32">
                <DockPanel Margin="4,0,4,28">
                    <Image DockPanel.Dock="Left"
                           Width="44"
                           Height="44"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <BitmapImage UriSource="pack://application:,,,/WinTab;component/wintab-logo.png" DecodePixelWidth="132" />
                        </Image.Source>
                    </Image>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinTab" FontSize="20" FontWeight="Medium" LineHeight="26" />
                        <TextBlock x:Name="HeroDescriptionText"
                                   Text="Keep File Explorer windows in one tab set"
                                   Margin="0,3,0,0"
                                   FontSize="13"
                                   LineHeight="18"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <TextBlock x:Name="ExplorerSectionTitleText" Text="File Explorer" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <DockPanel>
                                <CheckBox x:Name="WindowHookToggle" DockPanel.Dock="Right" Style="{StaticResource SettingToggleStyle}" />
                                <StackPanel>
                                    <TextBlock x:Name="WindowHookTitleText" Text="Merge new windows" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="WindowHookDescText" Text="Send new folders back to the active Explorer tab group" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <DockPanel>
                                <CheckBox x:Name="ReuseTabsToggle" DockPanel.Dock="Right" Style="{StaticResource SettingToggleStyle}" />
                                <StackPanel>
                                    <TextBlock x:Name="ReuseTabsTitleText" Text="Reuse existing tabs" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="ReuseTabsDescText" Text="Open a matching path by focusing its current tab" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource LastSettingRowStyle}">
                            <DockPanel>
                                <CheckBox x:Name="DoubleClickCloseToggle" DockPanel.Dock="Right" Style="{StaticResource SettingToggleStyle}" />
                                <StackPanel>
                                    <TextBlock x:Name="DoubleClickTitleText" Text="Double-click closes tab" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="DoubleClickDescText" Text="Close the current Explorer tab from its title area" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="BypassHintText"
                           Text="Hold Ctrl + Shift while opening a folder to skip merging and use a separate window"
                           Style="{StaticResource FootnoteStyle}" />

                <TextBlock x:Name="SystemSectionTitleText" Text="System" Style="{StaticResource SectionTitleStyle}" Margin="4,24,0,8" />
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <DockPanel>
                                <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource SettingToggleStyle}" />
                                <StackPanel>
                                    <TextBlock x:Name="StartupTitleText" Text="Start with Windows" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="StartupDescText" Text="Run quietly after sign-in" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRowStyle}">
                            <DockPanel>
                                <CheckBox x:Name="ShowTrayIconToggle" DockPanel.Dock="Right" Style="{StaticResource SettingToggleStyle}" />
                                <StackPanel>
                                    <TextBlock x:Name="ShowTrayIconTitleText" Text="Show tray icon" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="ShowTrayIconDescText" Text="Keep WinTab available from the notification area" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource LastSettingRowStyle}">
                            <DockPanel>
                                <CheckBox x:Name="AutoUpdateToggle" DockPanel.Dock="Right" Style="{StaticResource SettingToggleStyle}" />
                                <StackPanel>
                                    <TextBlock x:Name="AutoUpdateTitleText" Text="Check for updates automatically" Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock x:Name="AutoUpdateDescText" Text="Notify when a new release is available" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="AboutSectionTitleText" Text="About" Style="{StaticResource SectionTitleStyle}" Margin="4,24,0,8" />
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <Border Style="{StaticResource LastSettingRowStyle}">
                        <DockPanel>
                            <Button x:Name="CheckUpdatesButton"
                                    DockPanel.Dock="Right"
                                    Content="Check for updates"
                                    Style="{StaticResource FlatButtonStyle}"
                                    VerticalAlignment="Center"
                                    Margin="24,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AboutVersionText" Text="WinTab" Style="{StaticResource SettingTitleStyle}" />
                                <TextBlock x:Name="AboutLinksText" Style="{StaticResource SettingDescriptionStyle}">
                                    <Run Text="MIT License  ·  " /><Hyperlink x:Name="OpenSourceLink"
                                                                              NavigateUri="https://github.com/OUBIGFA/WinTab"
                                                                              RequestNavigate="OpenSourceLink_RequestNavigate"><Run Text="GitHub" /></Hyperlink>
                                </TextBlock>
                                <TextBlock x:Name="UpdateFeedbackText" Style="{StaticResource SettingDescriptionStyle}" Visibility="Collapsed" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
