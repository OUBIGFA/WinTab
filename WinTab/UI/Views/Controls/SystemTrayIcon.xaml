<UserControl x:Class="WinTab.UI.Views.Controls.SystemTrayIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar">

    <tb:TaskbarIcon x:Name="TrayIcon"
                    Visibility="Visible"
                    TrayMouseDoubleClick="OnNotifyIconDoubleClick">
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="OpenSettingsMenu" Header="Open WinTab" />
                <Separator />
                <MenuItem x:Name="RestoreGroupMenu" Header="Restore last tab group" />
                <MenuItem x:Name="ReopenTabMenu" Header="Reopen last closed tab" />
                <MenuItem x:Name="RecordClosedTabsMenu" Header="Remember recently closed tabs" IsCheckable="True" StaysOpenOnClick="True" />
                <Separator />
                <MenuItem x:Name="WindowHookMenu" Header="Merge new windows" IsCheckable="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="ReuseTabsMenu" Header="Reuse opened tabs" IsCheckable="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="MiddleClickForegroundMenu" Header="Open middle-clicked tabs in foreground" IsCheckable="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="DoubleClickCloseMenu" Header="Double-click to close tabs" IsCheckable="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="WheelSwitchMenu" Header="Scroll to switch tabs" IsCheckable="True" StaysOpenOnClick="True" />
                <Separator />
                <MenuItem x:Name="StartupMenu" Header="Start with Windows" IsCheckable="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="AutoUpdateMenu" Header="Check for updates automatically" IsCheckable="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="ShowTrayIconMenu" Header="Show tray icon" IsCheckable="True" StaysOpenOnClick="True" />
                <Separator />
                <MenuItem x:Name="CheckUpdatesMenu" Header="Check for updates" />
                <MenuItem x:Name="ExitMenu" Header="Exit" />
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>

</UserControl>
